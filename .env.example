# ─────────────────────────────────────────────────────────────
# AgreeGate environment
# Copy this file to ".env.local" and fill in what you want.
#
# Out of the box (NO setup, all free): Bluesky + Stack Exchange + Hacker News.
# Reddit and X are OPTIONAL and off unless you add credentials below.
# ─────────────────────────────────────────────────────────────

# Stack Exchange (optional). Works with no key (~300 req/day per IP).
# A free, no-approval key raises the quota to 10k/day: https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=

# Reddit (OPTIONAL). Reddit closed self-serve API signup in late 2025 — new
# access requires approval via Reddit's Developer Support form. If you have
# approved credentials (or legacy pre-2025 keys), add them here to enable
# Reddit results + the optional "Connect Reddit" login.
#   redirect uri (for login): http://localhost:3000/api/auth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: override the Reddit OAuth redirect URI (else derived from origin).
# REDDIT_REDIRECT_URI=

# Secret used to encrypt the session cookie for logged-in Reddit users.
# Set a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# X / Twitter (OPTIONAL). X's API now requires a PAID plan to search posts,
# so it's off by default. Add a Bearer Token to enable it (bot-filtered).
X_BEARER_TOKEN=
