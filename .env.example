# ─────────────────────────────────────────────────────────────
# AgreeGate environment
# Copy this file to ".env.local" and fill in what you want.
#
# Out of the box (NO setup): Bluesky + Lemmy + Stack Exchange + Hacker News.
# Reddit & X need your self-hosted SearXNG instance (free on Railway).
# ─────────────────────────────────────────────────────────────

# SearXNG — powers Reddit & X link previews (Google-style SERP cards).
# Deploy SearXNG on Railway, then set this to your public URL (no trailing slash).
# See docs/searxng-railway.md for setup.
SEARXNG_URL=

# Lemmy (optional). Defaults to https://lemmy.world
# LEMMY_INSTANCE=https://lemmy.world

# Stack Exchange (optional). Free key: https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=
