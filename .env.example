# ─────────────────────────────────────────────────────────────
# AgreeGate environment
# Copy this file to ".env.local" and fill in what you want.
#
# Out of the box (NO setup): Bluesky + Lemmy + Stack Exchange + Hacker News.
# Reddit & X need your self-hosted SearXNG instance (free on Railway).
# ─────────────────────────────────────────────────────────────

# SearXNG — powers Reddit & X link previews (Google-style SERP cards).
# Single instance (legacy):
SEARXNG_URL=
# Pool of instances — comma-separated, different hosts/regions recommended.
# AgreeGate rotates on suspension or per-instance rate limits (see docs).
# SEARXNG_URLS=https://searxng-a.up.railway.app,https://searxng-b.up.railway.app

# Per-instance cap on SearXNG calls per minute. Default: 10 per host.
# Each search uses up to 2 calls (1 Reddit + 1 X). Cached previews skip SearXNG.
# SEARXNG_MAX_REQUESTS_PER_MIN=10
# SEARXNG_RATE_WINDOW_MS=60000
# How long to skip an instance after upstream engine suspension. Default: 30 min.
# SEARXNG_INSTANCE_COOLDOWN_MS=1800000

# Cache Reddit/X preview results per query (milliseconds). Default: 30 minutes.
# Empty preview results are cached briefly (2 min) so engines can recover.
# SEARXNG_PREVIEW_CACHE_MS=1800000
# SEARXNG_PREVIEW_EMPTY_CACHE_MS=120000

# Max preview cards returned per source. Default: 6 Reddit, 5 X.
# REDDIT_PREVIEW_LIMIT=6
# X_PREVIEW_LIMIT=5

# Lemmy (optional). Defaults to https://lemmy.world
# LEMMY_INSTANCE=https://lemmy.world

# Stack Exchange (optional). Free key: https://stackapps.com/apps/oauth/register
STACKEXCHANGE_KEY=
